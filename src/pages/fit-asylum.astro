---
/**
 * Fit Asylum partner page: 15% off Mr BITE for their members.
 *
 * Restyled 2026-10-25 from the site's own parts (hero wash, dotted eyebrow,
 * h1.display, the card and coral-panel recipes, .btn-primary, DownloadButtons,
 * the trust strip). The first cut used --coral for text, which the design
 * system reserves for fills (2.89:1 on white, fails WCAG AA), and --faint as a
 * background, which is a grey TEXT colour and painted the code box a flat mid
 * grey. Both are gone.
 *
 * WHY THE SUBSCRIPTION IS BOUGHT HERE AND NOT IN THE APP
 * A Stripe code cannot be redeemed on an in-app purchase. Google Play
 * subscription promo codes only grant a free trial of 3 to 90 days, never a
 * percentage, and Play custom codes carry a 2,000 redemption minimum and are
 * limited to people who never subscribed. Apple's custom offer codes set a
 * price point for a duration rather than a percentage, and the app ships no
 * StoreKit redemption sheet. Stripe web checkout is the only route that charges
 * exactly 15% less on both platforms, today, and it keeps the store's cut.
 * Subscribe here, then sign in to the app: same account either way.
 *
 * noindex: a partner rate is not a public offer and should not rank against
 * the main paywall.
 */
import Base from '../layouts/Base.astro';
import DownloadButtons from '../components/DownloadButtons.astro';
import { icon } from '../lib/icons';
import { SITE } from '../config';

const PARTNER = 'Fit Asylum';
const CODE = 'FITASYLUM15';
const PERCENT = 15;
const checkoutUrl = `/pro?code=${CODE}`;

const trust = [
  { label: 'Secure checkout by Stripe', icon: 'lock' },
  { label: 'We never sell your data', icon: 'shield' },
  { label: 'Cancel any time', icon: 'trash' },
];
---

<Base
  title={`${PERCENT}% off Mr BITE for ${PARTNER} members`}
  description={`${PARTNER} members get ${PERCENT}% off Mr BITE, the nutrition tracker and AI coach. Use code ${CODE}.`}
  noindex
>
  <section class="fa-top">
    <div class="fa-bg" aria-hidden="true"></div>
    <div class="container fa-inner">
      <div class="fa-copy reveal in">
        <span class="fa-eyebrow">{PARTNER} members</span>
        <h1 class="display">{PERCENT}% off<br /><span class="coral-text">Mr BITE.</span></h1>
        <p class="fa-lead">
          Your nutrition tracker and AI coach, at the members' rate. Log any meal in
          seconds and let Mr BITE coach you to your goals.
        </p>

        <!-- The code is what people came for, so it leads, inside the site's
             coral panel. Tap to copy, because this is read on a phone. -->
        <div class="fa-code-panel">
          <p class="fa-code-label">Your code</p>
          <button class="fa-code" id="fa-code" type="button" data-code={CODE} aria-label={`Copy discount code ${CODE}`}>
            <span class="fa-code-text">{CODE}</span>
            <span class="fa-code-hint" id="fa-code-hint">
              <span set:html={icon('spark', { size: 14, stroke: 2 })} />Tap to copy
            </span>
          </button>
          <p class="fa-code-note">{PERCENT}% off, for as long as you stay subscribed.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section fa-steps-wrap">
    <div class="container fa-narrow">
      <ol class="fa-steps">
        <li class="fa-step fa-step-featured reveal">
          <span class="fa-num">1</span>
          <div class="fa-step-body">
            <h2>Claim your {PERCENT}% off</h2>
            <p>The code is already applied. Pick monthly or yearly and you'll see the discounted price before you pay.</p>
            <a class="btn btn-primary fa-claim" href={checkoutUrl}>Claim {PERCENT}% off</a>
          </div>
        </li>
        <li class="fa-step reveal">
          <span class="fa-num">2</span>
          <div class="fa-step-body">
            <h2>Download the app</h2>
            <p>Sign in with the same email you used at checkout and your membership is already there.</p>
            <DownloadButtons />
          </div>
        </li>
      </ol>

      <!-- Load-bearing, not fine print: subscribing from inside the app charges
           full store price and the code does nothing, with no error to say so.
           Cheaper to say it here than to refund it later. -->
      <aside class="fa-notice reveal" role="note">
        <span class="fa-notice-icon" set:html={icon('target', { size: 20, stroke: 1.8 })} />
        <p>
          <strong>Subscribe on this page, not inside the app.</strong>
          The App Store and Google Play can't take a discount code, so subscribing in
          the app charges the full price.
        </p>
      </aside>

      <ul class="fa-trust reveal" aria-label="Checkout and privacy">
        {trust.map((t) => (
          <li><span class="fa-trust-icon" set:html={icon(t.icon, { size: 20, stroke: 1.7 })} />{t.label}</li>
        ))}
      </ul>

      <p class="fa-help">
        Any trouble? Email <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a> and mention {PARTNER}.
      </p>
    </div>
  </section>
</Base>

<script is:inline>
  (() => {
    const btn = document.getElementById('fa-code');
    const hint = document.getElementById('fa-code-hint');
    if (!btn || !hint) return;
    const idle = hint.innerHTML;
    let timer;
    const say = (html) => {
      hint.innerHTML = html;
      clearTimeout(timer);
      timer = setTimeout(() => { hint.innerHTML = idle; }, 2400);
    };
    btn.addEventListener('click', async () => {
      const code = btn.dataset.code || '';
      try {
        await navigator.clipboard.writeText(code);
        say('Copied');
      } catch {
        // Clipboard is blocked in some in-app browsers (Instagram's included).
        // Select the text instead, and never claim a copy that did not happen,
        // or the member pastes nothing at checkout and blames the code.
        const target = btn.querySelector('.fa-code-text');
        if (target) {
          const range = document.createRange();
          range.selectNodeContents(target);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
        say('Press and hold to copy');
      }
    });
  })();
</script>

<style>
  /* ---- Top: the hero's wash, centred ------------------------------------ */
  .fa-top {
    position: relative; overflow: hidden;
    padding-top: clamp(36px, 6vw, 76px);
    padding-bottom: clamp(8px, 2vw, 16px);
  }
  .fa-bg {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(48% 46% at 50% 8%, rgba(253, 102, 100, 0.11), transparent 70%),
      radial-gradient(36% 34% at 94% 30%, rgba(254, 154, 153, 0.06), transparent 70%);
  }
  .fa-inner { display: flex; justify-content: center; }
  .fa-copy {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    max-width: 600px; width: 100%; min-width: 0;
  }
  .fa-eyebrow {
    display: inline-flex; align-items: center; gap: 8px; margin-bottom: 18px;
    font-size: 0.76rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--coral-600);
  }
  .fa-eyebrow::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--coral); }
  .fa-copy h1 { font-size: clamp(2.6rem, 7vw, 4.4rem); margin: 0; }
  .fa-lead {
    max-width: 44ch;
    margin-top: clamp(16px, 2.2vw, 22px);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    font-weight: 500; line-height: 1.55; color: var(--ink-soft);
    text-wrap: pretty;
  }

  /* The site's .panel--coral recipe, as a self-contained card. */
  .fa-code-panel {
    width: 100%; max-width: 440px;
    margin-top: 30px;
    padding: 22px;
    border-radius: var(--r-xxl);
    background: linear-gradient(152deg, #fffafa 0%, #fff0f0 100%);
    border: 1px solid var(--coral-100);
    box-shadow: var(--shadow-md);
  }
  .fa-code-label {
    font-size: 0.74rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--coral-600);
    margin-bottom: 12px;
  }
  .fa-code {
    width: 100%;
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    padding: 16px 14px;
    border: 2px dashed var(--coral-300);
    border-radius: var(--r-lg);
    background: #fff;
    color: var(--ink);
    font: inherit; cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease), transform var(--dur-base) var(--ease);
  }
  .fa-code:hover { border-color: var(--coral-600); transform: translateY(-1px); }
  .fa-code-text {
    font-size: clamp(1.5rem, 6.4vw, 2rem);
    font-weight: 800;
    /* Wide tracking so O and 0, I and 1 cannot be confused off a screen. */
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
  }
  .fa-code-hint {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.8rem; font-weight: 600; color: var(--coral-600);
  }
  .fa-code-note { margin-top: 12px; font-size: 0.9rem; color: var(--muted); }

  /* ---- Steps: the site's card recipe, step 1 featured ------------------- */
  .fa-steps-wrap { padding-top: var(--space-section-tight); }
  .fa-narrow { max-width: 720px; }
  .fa-steps { list-style: none; padding: 0; display: grid; gap: 16px; }
  .fa-step {
    display: flex; gap: 18px; align-items: flex-start;
    padding: 24px;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--r-xl);
    box-shadow: var(--shadow-sm);
  }
  /* Same "featured" cue as the yearly plan on /pro: coral hairline, lifted. */
  .fa-step-featured { border-color: var(--coral-300); box-shadow: var(--shadow-md); }
  .fa-num {
    flex: none;
    width: 36px; height: 36px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--coral-cta); color: #fff;
    font-weight: 800; font-size: 1rem;
  }
  .fa-step-body { min-width: 0; flex: 1; }
  .fa-step-body h2 { font-size: 1.2rem; font-weight: 700; letter-spacing: -0.015em; margin-bottom: 6px; }
  .fa-step-body p { color: var(--muted); line-height: 1.55; margin-bottom: 18px; }
  .fa-claim { width: auto; }

  /* A notice in the brand's warm tint, body text in full ink for contrast. */
  .fa-notice {
    margin-top: 22px;
    display: flex; gap: 14px; align-items: flex-start;
    padding: 18px 20px;
    border-radius: var(--r-lg);
    background: var(--coral-100);
    border: 1px solid var(--coral-300);
  }
  .fa-notice-icon { flex: none; display: inline-flex; color: var(--coral-600); margin-top: 1px; }
  .fa-notice p { font-size: 0.95rem; line-height: 1.55; color: var(--ink); }
  .fa-notice strong { display: block; margin-bottom: 2px; }

  .fa-trust {
    list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 14px 32px;
    margin-top: 34px; padding: 0;
  }
  .fa-trust li { display: inline-flex; align-items: center; gap: 9px; font-size: 0.92rem; font-weight: 500; color: var(--ink-soft); }
  .fa-trust-icon { display: inline-flex; color: var(--coral-600); }

  .fa-help { margin-top: 26px; text-align: center; font-size: 0.9rem; color: var(--muted); }
  .fa-help a { color: var(--coral-600); font-weight: 600; text-decoration: underline; }

  /* ---- Breakpoints: the site's scale ------------------------------------ */
  @media (max-width: 900px) {
    .fa-bg {
      background:
        radial-gradient(60% 40% at 50% 6%, rgba(253, 102, 100, 0.07), transparent 70%),
        radial-gradient(40% 36% at 96% 30%, rgba(254, 154, 153, 0.05), transparent 70%);
    }
  }
  @media (max-width: 560px) {
    .fa-top { padding-top: 22px; }
    .fa-code-panel { padding: 18px; margin-top: 24px; }
    .fa-step { padding: 20px; gap: 14px; }
    /* Full-width claim button on phones: it is the primary action and a
       content-width button reads as secondary next to the badges. */
    .fa-claim { width: 100%; }
  }
</style>
