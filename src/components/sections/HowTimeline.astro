---
// The weekly loop, four beats. Onboarding lives in the lede rather than as a step,
// because it happens once and this section is about the week. The lede has to name
// calories and protein: three later lines lean on "your targets" and this is the only
// place on the homepage that says what a target actually is.
//
// Step 1 keeps the four logging methods in prose even though the hero widget shows
// them, because that widget is aria-hidden. Without this line a screen reader user
// never meets them.
const steps = [
  { title: 'Log a meal in seconds', body: 'Photo, barcode, voice, or search. BITE does the macro maths.' },
  { title: 'Ask Mr Bite for the week', body: 'Tell him what you feel like eating and he plans your week around your targets.' },
  { title: 'Shop from one list', body: 'The whole week becomes a single list, sorted by aisle.' },
  { title: 'See it working', body: 'Weight and macro trends update as you go.' },
];
---

<section id="how" class="section">
  <div class="container">
    <div class="section-head reveal">
      <h2 class="display">How BITE runs your week.</h2>
      <p class="lede">A short setup sets your calorie and protein targets. Then every week looks like this.</p>
    </div>

    <!-- role=list restores the semantics that list-style: none strips in Safari.
         The visible numeral is aria-hidden so it is not announced on top of the
         list position the ordered list already conveys. -->
    <ol class="tl-steps" role="list">
      {steps.map((st, i) => (
        <li class="tl-step reveal" role="listitem" style={`--d:${(i * 0.07).toFixed(2)}s`}>
          <span class="tl-node" aria-hidden="true">{i + 1}</span>
          <div class="tl-content">
            <h3>{st.title}</h3>
            <p>{st.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* No JavaScript here by design. The shared .reveal observer in Base.astro already
     computes "this step is in view", one shot, with a reduced-motion path and a
     no-IntersectionObserver fallback. The old scroll scrubber computed the same fact
     a second time from rect maths anchored to a different line on the screen, so the
     node lit up several hundred pixels away from where its own text faded in. That
     desync was the clunkiness. One system, in sync by construction. */
  .tl-steps {
    --tl-node: 46px;
    list-style: none; margin: 0; padding: 0;
    max-width: 640px;   /* shares the measure of .section-head */
  }

  .tl-step {
    --d: 0s;   /* overridden per step inline; only consumed above 620px, see below */
    position: relative;
    display: grid; grid-template-columns: var(--tl-node) 1fr; align-items: start;
    column-gap: 20px;
    padding-bottom: clamp(24px, 3.5vw, 38px);
  }
  .tl-step:last-child { padding-bottom: 0; }
  /* Fade only, no rise. The connector belongs to the step above it, so if steps moved
     on staggered beats the line's lower end would part company with the node it points
     at for the length of the offset. Fading keeps both ends of every line together. */
  .tl-step.reveal { transform: none; }

  /* The connector belongs to the step it starts from, running from that node's bottom
     edge to the next node's top edge. That means it travels with the step's reveal
     transform instead of sliding against a fixed rail, and it cannot dangle past the
     final node the way a single absolutely positioned rail did. */
  .tl-step:not(:last-child)::before {
    content: ''; position: absolute;
    left: calc(var(--tl-node) / 2 - 1px);
    top: var(--tl-node); bottom: 0; width: 2px;
    background: var(--line);
    transition: background var(--dur-slow) var(--ease);
  }
  .tl-step.in::before { background: var(--coral-300); }

  /* Soft coral, not --coral-cta: filling every node with the exact button colour made
     the timeline shout louder than the actual buttons. Numerals are --muted rather
     than --faint, which sat at 2.54:1 and failed AA. */
  .tl-node {
    position: relative; z-index: 1;   /* keeps the connector from crossing the circle */
    width: var(--tl-node); height: var(--tl-node); border-radius: 50%;
    display: grid; place-items: center;
    background: #fff; border: 2px solid var(--line); color: var(--muted);
    font-weight: 800; font-size: 1.02rem; font-variant-numeric: tabular-nums;
    transition: background var(--dur-slow) var(--ease), border-color var(--dur-slow) var(--ease), color var(--dur-slow) var(--ease);
  }
  .tl-step.in .tl-node { background: var(--coral-100); border-color: var(--coral-300); color: var(--ink); }

  .tl-content { padding-top: 10px; }
  .tl-content h3 { font-size: 1.15rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 5px; }
  .tl-content p { color: var(--muted); font-size: 1rem; line-height: 1.6; }

  /* Above 620px the steps share a viewport and would pop in as one block, so they are
     staggered off the per-step --d. On a phone they are tall enough to cross the
     observer one at a time, where a delay is not a stagger, just lag on the thing the
     reader is already looking at. So the delay is only consumed at the wider widths. */
  @media (min-width: 621px) {
    .tl-step, .tl-step .tl-node, .tl-step::before { transition-delay: var(--d); }
  }

  @media (max-width: 620px) {
    .tl-steps { --tl-node: 40px; }
    .tl-step { column-gap: 16px; }
    .tl-content { padding-top: 7px; }
    .tl-content h3 { font-size: 1.08rem; }
    .tl-content p { font-size: 0.95rem; }
  }

  /* Reduced motion needs the LIT state as the default, not as a scroll-triggered one.
     global.css forces .reveal visible at load, but .in still only arrives on scroll,
     which would leave readable text beside grey "not reached yet" nodes. */
  @media (prefers-reduced-motion: reduce) {
    .tl-step, .tl-node, .tl-step::before { transition: none !important; transition-delay: 0s !important; }
    .tl-node { background: var(--coral-100); border-color: var(--coral-300); color: var(--ink); }
    .tl-step:not(:last-child)::before { background: var(--coral-300); }
  }
</style>
