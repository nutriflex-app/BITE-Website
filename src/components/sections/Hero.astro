---
import DownloadButtons from '../DownloadButtons.astro';
---

<section class="top">
  <div class="top-bg" aria-hidden="true"></div>

  <div class="container">
    <!-- Hero ships with `reveal in` pre-applied so the LCP headline paints
         immediately and never fades in on load. Keep this if .reveal changes. -->
    <div class="top-copy reveal in">
      <h1 class="display">Nutrition,<br /><span class="coral-text">made effortless.</span></h1>
      <!-- The mission, promoted out of the showcase section into the hero: it is
           the promise the whole page argues for, so it reads as the headline's
           subtext rather than as a caption above the screens. -->
      <p class="top-mission">
        Our mission is to make losing weight, and keeping it off, as convenient and
        accessible as it can be. <span class="tm-aside">Away from fat loss fads,
        unsustainable diets, tedious tracking and fasting.</span> We want to be the
        sustainable one, the one that fits around your life.
      </p>
      <div class="top-cta">
        <DownloadButtons />
      </div>
      <!-- Trust line sits OUTSIDE .top-cta so it survives on phones, where the
           badges give way to the sticky getbar but the free promise still has
           to be said. "Free to start" rather than a flat "Free": logging and
           planning stay free, the AI features carry a monthly allowance, and
           the FAQ spells that out rather than letting the hero overpromise. -->
      <p class="top-trust">Free to start. Private. Delete anytime.</p>
    </div>
  </div>
</section>

<style>
  .top { position: relative; overflow: hidden; padding-top: clamp(36px, 6vw, 76px); padding-bottom: clamp(14px, 2vw, 26px); }
  .top-bg {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(50% 42% at 84% 14%, rgba(253, 102, 100, 0.12), transparent 70%),
      radial-gradient(40% 36% at 4% 4%, rgba(254, 154, 153, 0.05), transparent 70%);
  }
  /* Single column since the demo widget moved to its own section at the foot of
     the page (2026-08-04). Headline and mission carry their own measures rather
     than sharing one: the two-line lockup wants ~15ch, the mission wants ~54ch,
     and a single cap would either wrap the headline or run the prose too wide. */
  .top-copy {
    display: flex; flex-direction: column; align-items: flex-start; text-align: left;
    min-width: 0;
  }
  .top-mission {
    max-width: 54ch;
    margin-top: clamp(18px, 2.4vw, 26px);
    font-size: clamp(1.05rem, 1.55vw, 1.3rem);
    font-weight: 500;
    line-height: 1.55;
    color: var(--ink);
    text-wrap: pretty;   /* no orphan on the last line where supported */
  }
  /* The rejected-alternatives clause drops back to muted: it is the "not this"
     half of the sentence, so it reads as an aside inside the statement while the
     promise either side of it stays full ink. */
  .tm-aside { color: var(--muted); }
  /* Hero-scoped, so the global h1.display stays put for /pro and the checkout
     status pages (every other page sets its own h1 size). The cap is the column
     over 7.7em, which is what "made effortless." actually measures when rendered
     (measured off the painted pixels: a DOM range/clone under-reports it by ~8%
     and will talk you into an overflow). */
  .top-copy h1 { font-size: clamp(2.6rem, 7vw, 5rem); margin: 0; max-width: 15ch; }
  .top-cta { margin-top: 32px; }
  .top-cta :global(.dl) { align-items: flex-start; }
  .top-trust { margin-top: 12px; font-size: 0.85rem; font-weight: 500; color: var(--muted); }

  @media (max-width: 900px) {
    /* Stacking slides the copy under the right-hand wash, which at 0.12 alpha tinted
       the page enough to drag muted text under 4.5:1. Softened here rather than
       strengthened in a min-width twin, so the two halves cannot leave a fractional
       width matching neither. */
    .top-bg {
      background:
        radial-gradient(50% 42% at 84% 14%, rgba(253, 102, 100, 0.07), transparent 70%),
        radial-gradient(40% 36% at 4% 4%, rgba(254, 154, 153, 0.05), transparent 70%);
    }
    .top-copy { max-width: 500px; }
    /* "made effortless." is allowed to break here: three big lines read as a poster
       lockup, where forcing two would cap the type ~30% smaller. The binding
       constraint is therefore the longest WORD, "effortless." at 4.8em, which at
       the 4.6rem ceiling is 353px inside the 500px cap. */
    .top-copy h1 { font-size: clamp(2.6rem, 13vw, 4.6rem); }
    .top-cta { margin-top: 26px; }
  }

  @media (max-width: 560px) {
    .top { padding-top: 20px; padding-bottom: clamp(12px, 3vw, 20px); }
    .top-cta { display: none; }     /* sticky getbar carries the CTA at phone widths */
    /* With the CTA hidden this line sits directly under a much larger headline,
       so it needs its own breathing room rather than the CTA's. */
    .top-trust { margin-top: 20px; }
  }
</style>
