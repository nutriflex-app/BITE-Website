---
import { icon } from '../../lib/icons';

// The full Mr BITE loop. Each step folds in the feature it delivers, so the timeline
// in the How section replaces the old separate feature grid.
const steps = [
  { n: '1', icon: 'target', title: 'Set your target', body: 'A few quick questions set your daily calories and protein.' },
  { n: '2', icon: 'camera', title: 'Log any meal in seconds', body: 'Photo, barcode, voice, or search. Mr BITE does the macro maths.' },
  { n: '3', icon: 'chat', title: 'Ask Mr BITE for a plan', body: 'Tell him a goal or a craving; he fills your day to fit.' },
  { n: '4', icon: 'spark', title: 'Plan the whole week', body: 'Pick a few meals and Mr BITE maps the rest.' },
  { n: '5', icon: 'cart', title: 'Shop from one list', body: 'Your plan becomes one list, sorted by aisle.' },
  { n: '6', icon: 'chart', title: 'Watch it working', body: 'Weight and macro trends update as you go.' },
];
---

<section id="how" class="section how">
  <div class="container">
    <div class="section-head reveal">
      <h2 class="display">How Mr BITE runs your week.</h2>
      <p class="lede">From your first target to a sorted shopping list.</p>
    </div>

    <div class="how-body">
      <div class="timeline" data-timeline>
        <div class="tl-line" aria-hidden="true"><span class="tl-fill"></span></div>
        <ol class="tl-steps">
          {steps.map((st) => (
            <li class="tl-step reveal">
              <span class="tl-node">{st.n}</span>
              <div class="tl-content">
                <div class="tl-head">
                  <span class="tl-ico" set:html={icon(st.icon)} aria-hidden="true" />
                  <h3>{st.title}</h3>
                </div>
                <p>{st.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <aside class="how-aside reveal">
        <div class="how-card">
          <h3>Ready when you are.</h3>
          <p>The whole loop takes a few minutes to set up.</p>
          <a href="#download" class="how-card-link">Get the app<span aria-hidden="true"> →</span></a>
        </div>
      </aside>
    </div>
  </div>
</section>

<script is:inline>
  // "Zero to a plan" timeline: the connector line fills and each step lights up
  // in sequence as the user scrolls the section through the viewport.
  (() => {
    const tl = document.querySelector('[data-timeline]');
    if (!tl) return;
    const steps = [...tl.querySelectorAll('.tl-step')];
    const n = steps.length;
    if (!n) return;
    const apply = (p) => {
      // --p still scrubs both ways so the connector fill tracks scroll position
      tl.style.setProperty('--p', p.toFixed(3));
      steps.forEach((s, i) => {
        const thr = i === 0 ? 0.001 : i / (n - 1);
        // latch: only ever advance is-active on, never toggle off (matches the one-shot .reveal)
        if (p >= thr) s.classList.add('is-active');
      });
    };
    const reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) { apply(1); return; }
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = tl.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      // Begin filling only once the timeline has climbed to just below mid-screen, then
      // advance each step as it crosses the middle line. Height-aware so a tall timeline
      // on a narrow screen fills as you scroll through it, not before it is in view.
      const anchor = vh * 0.55;
      const p = (anchor - r.top) / Math.max(r.height, 1);
      apply(Math.max(0, Math.min(1, p)));
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    update();
  })();
</script>

<style>
  .how .section-head { margin-bottom: var(--space-head); }
  .how-body { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: clamp(36px, 5vw, 76px); align-items: start; }
  .how-aside { position: sticky; top: calc(var(--nav-h) + 34px); }
  .how-card { background: #fff; border: 1px solid var(--line); border-radius: var(--r-xl); padding: 26px 24px; box-shadow: var(--shadow-md); }
  .how-card h3 { font-size: 1.18rem; font-weight: 700; margin-bottom: 8px; letter-spacing: -0.01em; }
  .how-card p { color: var(--muted); font-size: 0.94rem; line-height: 1.55; margin-bottom: 20px; }
  .how-card-link { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: 0.95rem; color: var(--coral-600); }
  @media (hover: hover) { .how-card-link:hover { color: var(--coral); } }
  .timeline { position: relative; }
  .tl-line { position: absolute; left: calc(var(--tl-node) / 2 - 1px); top: 24px; bottom: 24px; width: 2px; border-radius: 2px; background: var(--line); overflow: hidden; z-index: 0; }
  .tl-fill { position: absolute; left: 0; top: 0; width: 100%; height: calc(var(--p, 0) * 100%); background: var(--coral-cta); transition: height 0.12s linear; }
  .tl-steps { position: relative; z-index: 1; list-style: none; margin: 0; padding: 0; }
  .tl-step { position: relative; display: grid; grid-template-columns: var(--tl-node) 1fr; column-gap: 22px; padding-bottom: clamp(26px, 4vw, 42px); }
  .tl-step:last-child { padding-bottom: 0; }
  .tl-node {
    grid-column: 1; z-index: 2; width: var(--tl-node); height: var(--tl-node); border-radius: 50%; display: grid; place-items: center;
    background: #fff; border: 2px solid var(--line); color: var(--faint); font-weight: 800; font-size: 1.05rem;
    transition: background var(--dur-slow) var(--ease), border-color var(--dur-slow) var(--ease), color var(--dur-slow) var(--ease), box-shadow var(--dur-slow) var(--ease);
  }
  .tl-step.is-active .tl-node { background: var(--coral-cta); border-color: var(--coral-cta); color: #fff; box-shadow: 0 0 0 5px var(--coral-100); }
  /* Content visibility is driven by the shared .reveal observer (reliable, fires as the
     step scrolls into view) - NOT by the scrubber, which only colors nodes + fills the line. */
  .tl-content { padding-top: 3px; }
  .tl-head { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
  .tl-ico { display: inline-flex; color: var(--coral-600); flex-shrink: 0; }
  .tl-ico :global(svg) { width: 20px; height: 20px; }
  .tl-content h3 { font-size: 1.2rem; font-weight: 700; letter-spacing: -0.01em; }
  .tl-content p { color: var(--muted); font-size: 1rem; line-height: 1.6; max-width: 58ch; }

  @media (max-width: 900px) {
    .how-body { grid-template-columns: 1fr; }
    .how-aside { display: none; }          /* sticky getbar covers conversion on mobile */
  }

  @media (max-width: 620px) {
    .timeline { --tl-node: 44px; }
    .tl-step { column-gap: 16px; }
    .tl-line { top: 22px; bottom: 22px; }
    .tl-content h3 { font-size: 1.1rem; }
    .tl-content p { font-size: 0.95rem; }
  }

  @media (max-width: 560px) {
    .timeline { --tl-node: 40px; }
    .tl-step { column-gap: 15px; }
    .tl-node { font-size: 1rem; }
    .tl-line { top: 20px; bottom: 20px; }
    .tl-content p { font-size: 0.92rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tl-content, .tl-node, .tl-fill { transition: none !important; }
  }
</style>
